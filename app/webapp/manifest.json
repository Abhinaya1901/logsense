{
	"_version": "2.0.0",
	"sap.app": {
		"id": "logsense",
		"type": "application",
		"i18n": {
			"bundleName": "logsense.i18n.i18n",
			"supportedLocales": [
				""
			],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"northwind": {
				"uri": "/northwind/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "logsense.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "logsense.i18n.i18n",
					"supportedLocales": [
						""
					],
					"fallbackLocale": ""
				}
			},
			"": {
				"dataSource": "northwind",
				"preload": true,
				"settings": {
					"useBatch": false,
					"defaultCountMode": "Inline"
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "logsense.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "products",
					"target": "products"
				},
				{
					"pattern": "products/{productId}",
					"name": "detail",
					"target": "detail"
				},
				{
					"pattern": "troubleshoot",
					"name": "troubleshoot",
					"target": "troubleshoot"
				}
			],
			"targets": {
				"products": {
					"id": "products",
					"name": "Products",
					"level": 1
				},
				"detail": {
					"id": "detail",
					"name": "ProductDetail",
					"level": 2
				},
				"troubleshoot": {
					"id": "troubleshoot",
					"name": "Troubleshoot",
					"level": 2
				}
			}
		}
	}
}
